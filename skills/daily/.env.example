# Harvest API credentials for the billables `daily` skill.
#
# Copy this file to `.env` (same folder) and fill in your values.
#
# SECURITY: never commit `.env` to git and never share the skill folder
# with `.env` included — the API key grants full access to your Harvest
# account. The sibling `.gitignore` covers git, but if you zip the skill
# to share with a coworker, remove `.env` first.
#
# Find both values at https://id.getharvest.com/developers:
#   HARVEST_ACCOUNT_ID  — your numeric account ID (top of the developer page)
#   HARVEST_API_KEY     — a personal access token you create on that page

HARVEST_ACCOUNT_ID=
HARVEST_API_KEY=

# The IANA timezone your working day happens in, e.g. Pacific/Auckland,
# Europe/London, America/New_York. REQUIRED, and there is no default: without it
# a day can't be dated, and reading one stops with a message naming this key
# rather than guess a boundary that could be up to twelve hours out.
# On Windows, if a run says it cannot load the zone: py -m pip install tzdata
TIMESHEET_TIMEZONE=

# ----------------------------------------------------------------------------
# OPTIONAL settings below — leave blank if you don't need them.
# ----------------------------------------------------------------------------

# Where ActivityWatch is listening. Leave blank for http://localhost:5600.
# Set it only if you moved AW off its default port, or run it on another
# machine — e.g. http://192.168.1.20:5600
TIMESHEET_ACTIVITY_URL=

# Where the skill keeps its `.mcp/` catalogs (Harvest assignments, etc.) — the same
# path is used to write them and to read them back.
# Leave blank to auto-detect: the current directory, or - when the skill is installed
# inside a workspace, i.e. at `<workspace>/skills/<name>` - that workspace. A plugin
# install is never inside a workspace, so auto-detection finds nothing there and you have
# to set this. When nothing resolves, a refresh stops with an error rather than write
# catalogs to a guessed path; set an absolute path here, e.g. C:\Users\you\Work
TIMESHEET_WORKSPACE=

# Where the workday screenshot grabber writes, and where the skill looks for the
# images when a block's window titles aren't enough to classify it.
# Leave blank for ~/Pictures/WorkScreenshots. If you set this, pass the same path to
# setup_screenshot_pipeline.ps1 -ScreenshotsDir so the scheduled task agrees with it.
TIMESHEET_SCREENSHOTS_DIR=

# Set to `true` to read your default calendar in classic Outlook (Windows only) as a
# fourth source: a calendar event your activity corroborates is drafted as a block, and
# one it does not is put to you as a question at review. Blank, or anything but `true`, is off —
# which is exactly today's behaviour. Not sure? Leave it blank and run the setup skill.
TIMESHEET_OUTLOOK_CALENDAR=

# OPTIONAL Dataverse / Power Platform ticket catalog.
# Only set these if you create work tickets in a Dataverse (Dynamics 365) org
# that sync to Harvest as projects, and you want ticket-number → title lookups.
# Requires the Power Platform CLI (`pac`) installed and authenticated.
# Leave both blank to skip the Dataverse refresh entirely (Harvest-only mode).
#   DATAVERSE_URL  — your org URL, e.g. https://yourorg.crm6.dynamics.com/
#   PAC_AUTH_PROFILE — the name of the `pac auth` profile for that org
DATAVERSE_URL=
PAC_AUTH_PROFILE=
